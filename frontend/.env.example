# Copy to .env and fill in values for local development.
# Never commit .env — it is gitignored.

# Vite dev server proxies /api → this URL, so VITE_API_URL is empty in dev.
# In production builds, set this to the gateway base URL.
VITE_API_URL=

# Keycloak OIDC settings
VITE_KEYCLOAK_URL=http://localhost:9090
VITE_KEYCLOAK_REALM=nexora_os
VITE_KEYCLOAK_CLIENT_ID=nexora-public
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/callback