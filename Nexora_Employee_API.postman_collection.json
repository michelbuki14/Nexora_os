  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-fetch a Keycloak access token (password grant) and store as {{token}}.",
          "// Runs before every request. Override by setting token manually if desired.",
          "const kc = pm.collectionVariables.get('keycloak_url') || 'http://localhost:8080';",
          "const url = kc + '/realms/nexora/protocol/openid-connect/token';",
          "const body = {",
          "  grant_type: 'password',",
          "  client_id: 'nexora-developer-portal',",
          "  username: 'mkasongo@myyahoo.com',",
          "  password: pm.collectionVariables.get('user_password') || '200300Bk@'",
          "};",
          "pm.sendRequest({",
          "  url: url, method: 'POST',",
          "  header: {'Content-Type':'application/x-www-form-urlencoded'},",
          "  body: { mode: 'urlencoded', urlencoded: Object.keys(body).map(k=>({key:k,value:body[k],type:'text'})) }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.log('Token fetch failed', err || res.text()); return; }",
          "  const t = res.json().access_token;",
          "  pm.collectionVariables.set('token', t);",
          "  console.log('Token acquired, len', t.length);",
          "});",
          ""
        ]
      }
    }
  ]
}